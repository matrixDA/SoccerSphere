@{
    ViewData["Title"] = "About";
}

<div class="container mt-4">
    <h1>About SoccerSphere</h1>

    <p style="font-size: 1.15rem; margin-top: 15px;">
        SoccerSphere is a simple ASP.NET MVC website designed to showcase information
        about soccer teams, players, match schedules, and statistics. The goal is to
        provide a clean and easy-to-use platform that organizes soccer-related data while
        demonstrating full-stack MVC development using controllers, views, models, and a
        database.
    </p>
</div>