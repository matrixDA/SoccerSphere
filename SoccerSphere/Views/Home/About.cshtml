@{
    ViewData["Title"] = "About";
}

<!-- Header bar


-->
<div style="background-color:#007bff; color:white; padding:20px; border-radius:6px; margin-bottom:20px;">
    <h2 class="m-0">About SoccerSphere</h2>
</div>

<!-- Content card -->
<div style="
    background:white;
    padding:25px;
    border-radius:8px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.08);
    max-width:900px;
">

    <p style="font-size: 1.15rem; line-height:1.8;">
        <strong>SoccerSphere</strong> is a full-stack ASP.NET MVC application designed to bring
        together information about soccer teams, players, match schedules, and statistics.
        This project was built to demonstrate key web development concepts including routing,
        controllers, views, database integration, model relationships, and dependency injection.
    </p>

    <h4 class="mt-4 mb-2" style="font-weight:600;">Our Purpose</h4>
    <p style="font-size:1.1rem; line-height:1.8;">
        Our goal is to provide a clean, simple, and engaging platform for exploring soccer-related
        data. Whether you want to browse teams, analyze statistics, or view player performance,
        SoccerSphere organizes the information in a way that is intuitive and visually easy to follow.
    </p>

    <h4 class="mt-4 mb-2" style="font-weight:600;">What You Can Explore</h4>
    <ul style="font-size:1.1rem; line-height:2;">
        <li><strong>Teams</strong> – Wins, draws, losses, revenue, country, and more.</li>
        <li><strong>Players</strong> – Goals, assists, match performance, ratings.</li>
        <li><strong>Match Schedules</strong> – (Team feature depending on your project scope.)</li>
        <li><strong>Stats</strong> – Combined player and team statistics.</li>
    </ul>

    <h4 class="mt-4 mb-2" style="font-weight:600;">Technologies Used</h4>
    <ul style="font-size:1.1rem; line-height:2;">
        <li>ASP.NET Core MVC 8</li>
        <li>Entity Framework Core</li>
        <li>SQL Server (LocalDB)</li>
        <li>Bootstrap for styling</li>
        <li>Dependency Injection (IServiceCollection)</li>
        <li>Git & GitHub for team collaboration</li>
    </ul>

    <h4 class="mt-4 mb-2" style="font-weight:600;">Teamwork & Development</h4>
    <p style="font-size:1.1rem; line-height:1.8;">
        This project was created collaboratively using GitHub, following structured coding
        practices. Each member contributed to different parts of the website such as database
        modeling, controllers, UI design, and navigation. The outcome is a functional,
        full-stack web application that reflects real-world development workflows.
    </p>

</div>