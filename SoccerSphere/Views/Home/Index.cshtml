@{
    ViewData["Title"] = "Home";
}

<div class="text-center" style="padding-top: 60px; padding-bottom: 40px;">

    <h1 style="font-size: 3rem; font-weight: 700; margin-bottom: 15px;">
        Welcome to <span style="color:#007bff;">SoccerSphere</span>
    </h1>

    <p style="font-size: 1.25rem; color: #555;">
        Explore teams, players, matches, and statistics — all in one place.
    </p>
</div>

<!-- Card section -->
<div class="container" style="max-width:900px; margin-top:40px;">
    <div style="
        background:white;
        padding:30px;
        border-radius:10px;
        box-shadow:0 4px 10px rgba(0,0,0,0.08);
        text-align:center;
    ">
        <h3 style="font-weight:600; margin-bottom:15px;">What is SoccerSphere?</h3>
        <p style="font-size:1.15rem; line-height:1.8;">
            SoccerSphere is an ASP.NET MVC application built to showcase various aspects of
            soccer including team statistics, player performance, and match insights.
            Navigate using the menu above or the quick buttons to begin exploring.
        </p>
    </div>
</div>