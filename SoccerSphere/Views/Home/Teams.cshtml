@model PlayerTeamViewModel
@{
    ViewData["Title"] = "All Teams";
}

<h2>All Teams</h2>
<a asp-action="Add" class="btn btn-primary btn-sm">Add</a>
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>
                <a asp-action="Teams" asp-route-sortOrder="@ViewData["NameSortParam"]">Team Name</a>
            </th>
            <th>
                <a asp-action="Teams" asp-route-sortOrder="@ViewData["WinsSortParam"]">Wins</a>
            </th>
            <th>
                <a asp-action="Teams" asp-route-sortOrder="@ViewData["DrawsSortParam"]">Draws</a>
            </th>
            <th>
                <a asp-action="Teams" asp-route-sortOrder="@ViewData["LossesSortParam"]">Losses</a>
            </th>
            <th>
                Actions
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var team in Model.Teams)
        {
            <tr>
                <td>@team.TeamName</td>
                <td>@team.Wins</td>
                <td>@team.Draws</td>
                <td>@team.Loses</td>
                <td>
                    <a asp-action="View" asp-route-id="@team.TeamId" class="btn btn-primary btn-sm">View</a>
                    <a asp-action="Delete" asp-route-id="@team.TeamId" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

