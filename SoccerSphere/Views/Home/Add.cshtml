@model PlayerTeamViewModel
@{
    string title = Model.CurrentTeam != null && Model.CurrentTeam.TeamId != 0 ? $"Edit - {Model.CurrentTeam.TeamName}" : "Add Team";
    ViewData["Title"] = title;
}

<div class="container mt-4 p-5">
    <h2>@ViewData["Title"]</h2>

    <div asp-validation-summary="All" class="text-danger"></div>

    <form asp-action="Add" method="post">
        <div class="form-group">
            <label asp-for="CurrentTeam.TeamName">Team Name:</label>
            <input asp-for="CurrentTeam.TeamName" class="form-control">
        </div>
        <div class="form-group">
            <label asp-for="CurrentTeam.Revenue">Revenue:</label>
            <input asp-for="CurrentTeam.Revenue" class="form-control" type="number" step="0.01">
        </div>
        <div class="form-group">
            <label asp-for="CurrentTeam.Country">Country:</label>
            <input asp-for="CurrentTeam.Country" class="form-control">
        </div>
        <div class="form-group">
            <label asp-for="CurrentTeam.Wins">Wins:</label>
            <input asp-for="CurrentTeam.Wins" class="form-control">

        </div>
        <div class="form-group">
            <label asp-for="CurrentTeam.Loses">Loses:</label>
            <input asp-for="CurrentTeam.Loses" class="form-control">
        </div>
        <div class="form-group">
            <label asp-for="CurrentTeam.Draws">Draws:</label>
            <input asp-for="CurrentTeam.Draws" class="form-control">
        </div>

        <input type="hidden" asp-for="CurrentTeam.TeamId" />

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Teams" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
