@model PlayerTeamViewModel
@{
	ViewBag.Title = "Delete" + Model.CurrentTeam.TeamName;
}

<h2>Confirm Deletion</h2>
<h3>@Model.CurrentTeam.TeamName - @Model.CurrentTeam.Country </h3>

<form asp-action="Delete" method="post">
	<input type="hidden" asp-for="@Model.CurrentTeam.TeamId" />

	<button type="submit" class="btn btn-primary">Delete</button>
	<a asp-controller="Home" asp-action="Teams" class="btn btn-primary">Cancel</a>
</form>
