@model PlayerTeamViewModel
@{
    ViewBag.Title = "Delete - " + Model.CurrentTeam.TeamName;
}


<div class="card shadow-lg mt-4">
        <div class="card-header bg-danger text-white fs-3">
            Confirm Deletion
        </div>
        <div class="card-body p-4" style="font-size: 1.25rem;">
            <h3 class="card-title">@Model.CurrentTeam.TeamName - @Model.CurrentTeam.Country</h3>
            <p class="card-text text-muted">
                Are you sure you want to delete this team? This action cannot be undone.
            </p>

            <form asp-action="Delete" method="post" class="mt-4">
                <input type="hidden" asp-for="CurrentTeam.TeamId" />

                <div class="d-flex justify-content-start gap-3">
                    <button type="submit" class="btn btn-danger btn-lg">Delete</button>
                    <a asp-action="Teams" class="btn btn-secondary btn-lg">Cancel</a>
                </div>
            </form>
        </div>
    </div>
