@model PlayerTeamViewModel

@{
    ViewData["Title"] = "View - " + Model.CurrentPlayer.PlayerName;
}

<div class="card shadow-lg w-100 mt-4" style="font-size: 1.5rem;">
        <div class="card-header bg-success text-white fs-2 py-3">
            Player: @Model.CurrentPlayer.PlayerName
        </div>
        <div class="card-body p-5">
            <h3 class="card-title">Country: @Model.CurrentPlayer.Country</h3>
            <p class="card-text">
                <strong>Postion:</strong> @Model.CurrentPlayer.Position.PositionName<br>
                <strong>Team:</strong> @Model.CurrentPlayer.Team.TeamName <br>
                <strong>Matches Played:</strong> @Model.CurrentPlayer.MatchesPlayed <br>
                <strong>Goals:</strong> @Model.CurrentPlayer.Goals <br>
                <strong>Assists:</strong> @Model.CurrentPlayer.Assists <br>
                <strong>Rating:</strong> @Model.CurrentPlayer.Rating
            </p>

            <div class="d-flex gap-3 mt-4">
                <a asp-action="Edit" asp-route-id="@Model.CurrentPlayer.PlayerId" class="btn btn-warning btn-lg">
                    Edit
                </a>
                <a asp-action="Delete" asp-route-id="@Model.CurrentPlayer.PlayerId" class="btn btn-danger btn-lg">
                    Delete
                </a>
            </div>
        </div>
    </div>
