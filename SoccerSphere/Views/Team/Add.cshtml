@model PlayerTeamViewModel
@{
    string title = Model.CurrentPlayer != null && Model.CurrentPlayer.PlayerId != 0 ? $"Edit - {Model.CurrentPlayer.PlayerName}" : "Add Player";
    ViewData["Title"] = title;
}

<div class="container mt-4 p-5">
    <h2>@ViewData["Title"]</h2>

    <form asp-controller="Team" asp-action="Add" method="post">

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="CurrentPlayer.PlayerName" class="form-label">Player Name</label>
            <input asp-for="CurrentPlayer.PlayerName" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="CurrentPlayer.PositionId" class="form-label">Position</label>
            <select asp-for="CurrentPlayer.PositionId" class="form-control"
                    asp-items="@(new SelectList(Model.Positions, "PositionId", "PositionName", Model?.CurrentPlayer?.PositionId))">
                <option value="">-- Select a Position --</option>

            </select>
        </div>

        <div class="form-group">
            <label asp-for="CurrentPlayer.Country" class="form-label"></label>
            <input asp-for="CurrentPlayer.Country" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="CurrentPlayer.TeamId" class="form-label">Team</label>
            <select asp-for="CurrentPlayer.TeamId" class="form-control"
                    asp-items="@(new SelectList(Model.Teams, "TeamId", "TeamName", Model?.CurrentPlayer?.TeamId))">
                <option value="">-- Select a Team --</option>
            </select>
        </div>

        <div class="row">
            <div class="col-4">
                <div class="form-group">
                    <label asp-for="CurrentPlayer.Goals" class="form-label"></label>
                    <input asp-for="CurrentPlayer.Goals" type="number" class="form-control" />
                </div>
            </div>
            <div class="col-4">
                <div class="form-group">
                    <label asp-for="CurrentPlayer.Assists" class="form-label"></label>
                    <input asp-for="CurrentPlayer.Assists" type="number" class="form-control" />
                </div>
            </div>
            <div class="col-4">
                <div class="form-group">
                    <label asp-for="CurrentPlayer.MatchesPlayed" class="form-label"></label>
                    <input asp-for="CurrentPlayer.MatchesPlayed" type="number" class="form-control" />
                </div>
            </div>
            <div class="col-4">
                <div class="form-group">
                    <label asp-for="CurrentPlayer.Rating" class="form-label"></label>
                    <input asp-for="CurrentPlayer.Rating" type="number" step="0.1" class="form-control" />
                </div>
            </div>
        </div>

        <input type="hidden" asp-for="CurrentPlayer.PlayerId" />

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-controller="Team" asp-action="Players" class="btn btn-secondary">Cancel</a>
        </div>

    </form>
</div>