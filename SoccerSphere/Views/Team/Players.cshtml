@model PlayerTeamViewModel
@{
    ViewData["Title"] = Model.CurrentTeam != null ? $"Players - {Model.CurrentTeam.TeamName}" : "All Players";
}

<h2>@ViewData["Title"]</h2>

<a asp-controller="Team" asp-action="Add" class="btn btn-primary mb-3">Add New Player</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>
                <a asp-action="Players" asp-route-id="@Model.CurrentTeam?.TeamId" asp-route-sortOrder="@ViewData["NameSortParam"]">Player Name</a>
            </th>
            <th>
                <a asp-action="Players" asp-route-id="@Model.CurrentTeam?.TeamId" asp-route-sortOrder="@ViewData["GoalsSortParam"]">Goals</a>
            </th>
            <th>
                <a asp-action="Players" asp-route-id="@Model.CurrentTeam?.TeamId" asp-route-sortOrder="@ViewData["AssistsSortParam"]">Assists</a>
            </th>
            @if (Model.CurrentTeam == null)
            {
                <th>
                    <a asp-action="Players" asp-route-sortOrder="@ViewData["TeamSortParam"]">Team</a>
                </th>
            }
            else
            {
                <th>Team</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var player in Model.Players)
        {
            <tr>
                <td>@player.PlayerName</td>
                <td>@player.Goals</td>
                <td>@player.Assists</td>
                <td>@player.Team.TeamName</td>
                <td>
                    <a asp-action="View" asp-route-id="@player.PlayerId" class="btn btn-primary btn-sm">View</a>
                    <a asp-action="Delete" asp-route-id="@player.PlayerId" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>