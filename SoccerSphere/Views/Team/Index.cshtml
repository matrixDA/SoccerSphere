@model IEnumerable<Player>
@{
    ViewBag.Title = "Soccer Players";
}

<h2>Soccer Player Stats</h2>

<a asp-controller="Team" asp-action="AddPlayer" class="btn btn-primary mb-3">Add New Player</a>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Player Name</th>
            <th>Country</th>
            <th>Team</th>
            <th>Goals</th>
            <th>Assists</th>
            <th>Matches</th>
            <th>Rating</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var player in Model)
        {
            <tr>
                <td>@player.PlayerName</td>
                <td>@player.Country</td>
                <td>
                    @(player.Team?.TeamName)
                </td>
                <td>@player.Goals</td>
                <td>@player.Assists</td>
                <td>@player.MatchesPlayed</td>
                <td>@player.Rating.ToString("F2")</td>
                <td>
                    <a asp-controller="Team" asp-action="Delete" asp-route-id="@player.PlayerId" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>