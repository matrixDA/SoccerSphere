@model IEnumerable<Team>
@{
    ViewData["Title"] = "Team";
}

<h2 class="p-2">All Teams</h2>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Team Name</th>
            <th>Revenue</th>
            <th>Country</th>
            <th>Wins</th>
            <th>Loses</th>
            <th>Draws</th>
        </tr>
    </thead>
    @foreach(var team in Model)
    {
        <tr>
            <td>@team.TeamName</td>
            <td>@team.Revenue</td>
            <td>@team.Country</td>
            <td>@team.Wins</td>
            <td>@team.Loses</td>
            <td>@team.Draws</td>
        </tr>
    }
</table>
