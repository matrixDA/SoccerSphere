@model Player
@{
    ViewBag.Title = "Add New Player";
}

<h2>Add New Player</h2>

<form asp-controller="Team" asp-action="AddPlayer" method="post">

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="PlayerName" class="form-label"></label>
        <input asp-for="PlayerName" class="form-control" />
        <span asp-validation-for="PlayerName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Country" class="form-label"></label>
        <input asp-for="Country" class="form-control" />
        <span asp-validation-for="Country" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="TeamId" class="form-label">Team</label>
        <select asp-for="TeamId" asp-items="@ViewBag.Teams" class="form-control">
            <option value="">-- Select a Team --</option>
        </select>
        <span asp-validation-for="TeamId" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-4">
            <div class="form-group">
                <label asp-for="Goals" class="form-label"></label>
                <input asp-for="Goals" type="number" class="form-control" />
            </div>
        </div>
        <div class="col-4">
            <div class="form-group">
                <label asp-for="Assists" class="form-label"></label>
                <input asp-for="Assists" type="number" class="form-control" />
            </div>
        </div>
        <div class="col-4">
            <div class="form-group">
                <label asp-for="MatchesPlayed" class="form-label"></label>
                <input asp-for="MatchesPlayed" type="number" class="form-control" />
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Add Player</button>
    <a asp-controller="Team" asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>